{
  "description": "Hand-authored fictional transcripts, expected facts, and contrasting profile-output fixtures. No model calls.",
  "keys": [
    "business_name",
    "category",
    "service_area",
    "email",
    "starting_price",
    "price_unit",
    "services",
    "delivery_timeline"
  ],
  "strategies": [
    {
      "id": "fill",
      "label": "Fill every field",
      "description": "A deliberately overconfident fixture: substitutes plausible defaults and promotes tentative details."
    },
    {
      "id": "nulls",
      "label": "Leave unknowns blank",
      "description": "Preserves known values and leaves missing fields null, but fails to surface ambiguity or request follow-up."
    },
    {
      "id": "grounded",
      "label": "Evidence + follow-up",
      "description": "Preserves supported facts, attaches transcript quotes, distinguishes missing and conflicting values, and asks focused questions."
    }
  ],
  "cases": [
    {
